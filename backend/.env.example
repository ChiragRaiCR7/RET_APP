# Copy to backend/.env and adjust. Every setting can also come from the environment.

# development | test | production  (production: Secure cookies, HSTS, no /api/docs)
ENV=development

# Where SQLite and workspace files live. Back this directory up.
# DATA_DIR=./data

# First start only: creates the "admin" account when the database has no users.
# Required in production; in development a random password is printed to the console.
# BOOTSTRAP_ADMIN_PASSWORD=change-me-to-something-long

# Browser origins allowed to make cookie-authenticated writes (JSON list).
# Not needed when the API serves the built frontend from its own origin.
# ALLOWED_ORIGINS=["http://localhost:5173"]

# Upload and scan budgets
# MAX_UPLOAD_MB=1024
# MAX_UNZIPPED_MB=2048
# MAX_SCAN_FILES=20000

# Azure OpenAI (optional). Without it, Ask works in retrieval-only mode.
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_CHAT_MODEL=<deployment name>
# AZURE_OPENAI_API_VERSION=2024-10-21
