
{
  "name": "ret-v4-frontend",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost --port 5173",
    "build": "vite build",
    "preview": "vite preview --host localhost --port 5173",
    "clean": "rimraf dist .vite",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --ignore-path .gitignore",
    "lint:check": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --max-warnings=0 --ignore-path .gitignore",
    "lint:fix": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix --ignore-path .gitignore",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "echo \"No typecheck configured (JS project)\"",
    "check": "npm run lint:check && npm run format:check && npm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.23",
    "@tanstack/vue-table": "^8.20.5",
    "axios": "^1.13.5",
    "chart.js": "^4.5.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.3.1",
    "lucide-vue-next": "^0.562.0",
    "marked": "^12.0.2",
    "mermaid": "^10.9.5",
    "pinia": "^2.3.0",
    "vue": "^3.5.24",
    "vue-chartjs": "^5.3.3",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "terser": "^5.46.0",
    "vite": "^7.2.4"
  },
  "lint-staged": {
    "*.{js,vue,cjs,mjs,jsx}": [
      "eslint --fix"
    ],
    "*.{js,vue,css,md,json}": [
      "prettier --write"
    ]
  }
}
