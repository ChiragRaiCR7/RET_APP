
{
  "compilerOptions": {
    /* JS + Vue + Vite basics */
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",

    /* You are using ONLY JavaScript */
    "allowJs": true,
    "checkJs": false,              // set to true if you want JS type-checking

    /* Quality-of-life and compatibility */
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,

    /* ⭐ Alias setup to match your Vite config:
       In vite.config.js you map '@' -> fileURLToPath(new URL('./src', import.meta.url))
       Here we map it for the TS server so editor understands '@/...' */
    "baseUrl": "src",
    "paths": {
      "@/*": ["*"]
    },

    /* Vite client types for env/import.meta */
    "types": ["vite/client"]
  },

  /* Let the language service see your source and env types */
  "include": ["src/**/*", "env.d.ts"],

  /* Keep builds fast and clean */
  "exclude": ["node_modules", "dist"]
}
